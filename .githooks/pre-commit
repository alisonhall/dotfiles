#!/usr/bin/env bash
#
# This repo is public. Blocks commits that contain secrets or personal info,
# shell files with syntax errors, paths that only work on one machine, or file
# names and paths that only work on some operating systems.
#
# Bypass a single check:  SKIP_GITLEAKS=1 git commit ...

status=0
patterns=()
repo_root="$(git rev-parse --show-toplevel)"

# 1. Secrets (API keys, tokens, passwords) - https://github.com/gitleaks/gitleaks
# install.sh may have put it in ~/.local/bin, which GUI git clients don't have on PATH
PATH="$PATH:$HOME/.local/bin"
if [ -n "${SKIP_GITLEAKS:-}" ]; then
	:
elif ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks isn't installed, so staged changes can't be scanned for secrets." >&2
	echo "  Run install.sh to install it, or commit with SKIP_GITLEAKS=1" >&2
	status=1
elif gitleaks git --help >/dev/null 2>&1; then
	gitleaks git --staged --redact --no-banner || status=1
else
	# gitleaks before v8.19 (e.g. older Linux distro packages)
	gitleaks protect --staged --redact --no-banner || status=1
fi

# 2. Personal strings listed in local/dotfiles_blocklist (that folder is this machine's own git
# repo, ignored by this one - see install.sh's setup_local_dir). Falls back to the older
# ~/.dotfiles_blocklist location for a machine that hasn't re-run install.sh since it moved.
blocklist="$repo_root/local/dotfiles_blocklist"
[ -f "$blocklist" ] || blocklist="$HOME/.dotfiles_blocklist"
if [ -f "$blocklist" ]; then
	patterns=()
	blocked=""
	while IFS= read -r line || [ -n "$line" ]; do
		line="${line%$'\r'}"
		case "$line" in ''|'#'*) continue ;; esac
		patterns+=(-e "$line")
		blocked+="$line"$'\n'
	done < "$blocklist"

	if [ ${#patterns[@]} -gt 0 ]; then
		matches="$(git grep --cached -I -n -i -F "${patterns[@]}")"
		# This repo's own GitHub URL (github.com/<owner>/<repo>) is already public, so it's allowed
		# even when the owner's name is blocked: drop it from each line and check what's left
		repo_url="$(git remote get-url origin 2>/dev/null | sed -nE 's#/$##; s#\.git$##; s#^.*github\.com[:/]([^/]+/[^/]+)$#github.com/\1#p')"
		# (One awk rather than grep per line: Git Bash's grep can crash there, which would read as
		# "no match". If awk fails, every match is kept.)
		if [ -n "$matches" ] && [ -n "$repo_url" ]; then
			filtered="$(printf '%s\n' "$matches" | REPO_URL="$repo_url" BLOCKED="$blocked" awk '
				BEGIN { url = tolower(ENVIRON["REPO_URL"]); n = split(tolower(ENVIRON["BLOCKED"]), word, "\n") }
				{
					# Drop each copy of the URL, unless it runs on into a longer name (dotfiles-old)
					line = ""; rest = tolower($0)
					while ((i = index(rest, url)) > 0) {
						end = i + length(url)
						line = line substr(rest, 1, substr(rest, end, 1) ~ /[a-z0-9_-]/ ? end - 1 : i - 1)
						rest = substr(rest, end)
					}
					line = line rest
					for (w = 1; w <= n; w++) if (word[w] != "" && index(line, word[w])) { print; next }
				}')" && matches="$filtered"
		fi
		if [ -n "$matches" ]; then
			echo "pre-commit: found strings from $blocklist in staged files:" >&2
			echo "$matches" >&2
			echo "  Move these into local/shell_local.sh or local/gitconfig instead." >&2
			status=1
		fi
	fi
fi
if [ "${#patterns[@]}" -eq 0 ]; then
	echo "pre-commit: WARNING - $blocklist is missing or empty, so personal strings (emails," >&2
	echo "  employer names...) aren't being checked. Copy it from another machine or add your own." >&2
fi

# 3. Shell syntax, so a broken file never reaches other machines
if ! bash "$repo_root/tools/check-syntax.sh" >&2; then
	echo "pre-commit: fix the errors above before committing." >&2
	status=1
fi

# 4. Hard-coded paths, so the repo keeps working wherever it's cloned
if ! bash "$repo_root/tools/check-paths.sh" >&2; then
	echo "pre-commit: replace the hard-coded paths above before committing." >&2
	status=1
fi

# 5. File names and paths that only work on some OSes
if ! bash "$repo_root/tools/check-portability.sh" >&2; then
	echo "pre-commit: fix the portability problems above before committing." >&2
	status=1
fi

# 6. Shell and git aliases that are broken, or only work on some OSes
if ! bash "$repo_root/tools/check-aliases.sh" >&2; then
	echo "pre-commit: fix the alias problems above before committing." >&2
	status=1
fi

exit $status

  "Starting Hook test file": {
    "scope": "typescript",
    "prefix": "start-test-hook",
    "body": [
      "import { renderHook } from '@testing-library/react-hooks';",
      "import { MockedProvider } from '@apollo/client/testing';",
      "import React from 'react';",
      "",
      "import { useExampleApi } from './use-example-api';",
      "import { EXAMPLE } from './use-example-api.graphql';",
      "import { mockResponse } from './use-example-api.mocks';",
      "",
      "describe('useExampleApi', () => {",
      "\tit('should return loading initially', async () => {",
      "\t\tconst { result, waitForNextUpdate } = renderHook(() => useExampleApi(), {",
      "\t\t\twrapper: ({ children }: { children: React.ReactNode }) => (",
      "\t\t\t\t<MockedProvider mocks={[mockResponse]} addTypename={false}>",
      "\t\t\t\t\t{children}",
      "\t\t\t\t</MockedProvider>",
      "\t\t\t),",
      "\t\t});",
      "",
      "\t\texpect(result.current.loading).toBe(true);",
      "\t\tawait waitForNextUpdate();",
      "\t});",
      "",
      "\tit('should return data after loading', async () => {",
      "\t\tconst { result, waitForNextUpdate } = renderHook(() => useExampleApi(), {",
      "\t\t\twrapper: ({ children }: { children: React.ReactNode }) => (",
      "\t\t\t\t<MockedProvider mocks={[mockResponse]} addTypename={false}>",
      "\t\t\t\t\t{children}",
      "\t\t\t\t</MockedProvider>",
      "\t\t\t),",
      "\t\t});",
      "\t\tawait waitForNextUpdate();",
      "\t\texpect(result.current.loading).toBe(false);",
      "\t\texpect(result.current.data).toEqual(mockResponse.result.data.example.data);",
      "\t});",
      "",
      "\tit('should handle errors', async () => {",
      "\t\tconst errorMocks = [",
      "\t\t\t{",
      "\t\t\t\trequest: {",
      "\t\t\t\t\tquery: EXAMPLE,",
      "\t\t\t\t},",
      "\t\t\t\terror: new Error('An error occurred'),",
      "\t\t\t},",
      "\t\t];",
      "",
      "\t\tconst { result, waitForNextUpdate } = renderHook(() => useExampleApi(), {",
      "\t\t\twrapper: ({ children }: { children: React.ReactNode }) => (",
      "\t\t\t\t<MockedProvider mocks={errorMocks} addTypename={false}>",
      "\t\t\t\t\t{children}",
      "\t\t\t\t</MockedProvider>",
      "\t\t\t),",
      "\t\t});",
      "",
      "\t\tawait waitForNextUpdate();",
      "\t\texpect(result.current.loading).toBe(false);",
      "\t\texpect(result.current.error).toBeDefined();",
      "\t});",
      "",
      "\tit('should skip query if skip is true', async () => {",
      "\t\tconst { result } = renderHook(() => useExampleApi(true), {",
      "\t\t\twrapper: ({ children }: { children: React.ReactNode }) => (",
      "\t\t\t\t<MockedProvider mocks={[mockResponse]} addTypename={false}>",
      "\t\t\t\t\t{children}",
      "\t\t\t\t</MockedProvider>",
      "\t\t\t),",
      "\t\t});",
      "",
      "\t\texpect(result.current.loading).toBeFalsy();",
      "\t\texpect(result.current.data).toBeUndefined();",
      "\t\texpect(result.current.error).toBeUndefined();",
      "\t});",
      "});",
      ""
    ],
    "description": "The starting point when creating a new component test file (ie. component-name.test.tsx)"
  },

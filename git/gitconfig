		shm = stash save
		shl = stash list --format='%Cred%h %C(yellow)%gd %C(cyan)(%cr): %C(auto)%gs' # List the stashes
		shl-COMMENT = !echo "List the stashes"
		shll = stash list --format='%n%n%Cred%h %C(yellow)%gd %C(cyan)(%cr): %C(auto)%gs' --stat # List the stashes and files changed within each
		shll-COMMENT = !echo "List the stashes and files changed within each"
		shs = !sh -c 'git stash show -p stash@{$1}' -- # Show the full diff of the stash
		shs-COMMENT = !echo "Show the full diff of the stash"
		shd = !sh -c 'git stash drop stash@{$1}' -- # Delete the named stash
		shd-COMMENT = !echo "Delete the named stash"
		sha = !sh -c 'git stash apply stash@{$1}' -- # Apply the changes in the named stash
		sha-COMMENT = !echo "Apply the changes in the named stash"
		shp = git stash push -p
		stash-partial = stash push -p -m # save partials to stash, iterating through each hunk, and save to the name in quotes after this command
		stash-partial-COMMENT = !echo "save partials to stash, iterating through each hunk, and save to the name in quotes after this command"

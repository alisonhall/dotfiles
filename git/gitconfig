		unstage = reset HEAD -- # git reset HEAD -- <file-name>  --> unstage file name
		unstage-COMMENT = !echo "git reset HEAD -- <file-name>  --> unstage file name"
		prune = remote prune origin
		remove-local-commit = reset HEAD~ # remove local commit, keep files

# Shared git config, included from the top of ~/.gitconfig by install.sh.
# Personal and machine-specific settings go in ~/.gitconfig itself (below the include), e.g.:
#   [user]
#   	name = Your Name
#   	email = you@example.com
#   [commit]
#   	template = ~/.stCommitMsg
[core]
	editor = nano
[diff]
	tool = vscode
[difftool "default-difftool"]
    cmd = code --wait --diff $LOCAL $REMOTE
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
[merge]
	tool = vscode
[mergetool "vscode"]
    cmd = code --wait $MERGED
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[mergetool "bc3"]
	trustExitCode = true
[alias]
	aliases = "!grepalias() { git config --get-regexp '^alias\\.' | awk -v nr=2 '{sub(/^alias\\./,\"\")};{printf \"\\033[31m%_20s\\033[1;37m\", $1};{sep=FS};{for (x=nr; x<=NF; x++) {printf \"%s%s\", sep, $x; }; print \"\\033[0;39m\"}'; }; grepalias"
	finda = "!grepalias() { git config --get-regexp '^alias\\.' | grep -i \"$1\" | awk -v nr=2 '{sub(/^alias\\./,\"\")};{printf \"\\033[31m%_20s\\033[1;37m\", $1};{sep=FS};{for (x=nr; x<=NF; x++) {printf \"%s%s\", sep, $x; }; print \"\\033[0;39m\"}'; }; grepalias"
	config-user-name = config user.name # use as-is to see the current user's name. Add a string after this command to change the current user's name.
	config-user-name-COMMENT = !echo "use as-is to see the current user's name. Add a string after this command to change the current user's name."
	config-user-email = config user.email # use as-is to see the current user's email. Add a string after this command to change the current user's email.
	config-user-email-COMMENT = !echo "use as-is to see the current user's email. Add a string after this command to change the current user's email."

	##### CLEANUP
		# See: delete-merged-local-branches OR bclean
		# See: prune
		# See: worktree-prune
		garbage-collection = gc

	##### CHECKOUT
		ch = checkout
		checkout-branch = checkout -b
		chb = checkout-branch

	##### STATUS
		s = status
		st = s

	##### PULL
		p = pull

	##### FETCH
		f = "!git fetch $CURRENT_REMOTE_NAME $1:$1"

	##### PUSH
		pu = "!f() { \
			local LAST_COMMIT_MESSAGE=$(git last-commit-message); \
			local PUSH_ARGS=\"$*\"; \
			if [[ $LAST_COMMIT_MESSAGE == *WIP* ]] && [[ $LAST_COMMIT_MESSAGE != *temp/WIP-improvements* ]]; then \
				echo Preventing push due to the previous commit message includes WIP; \
				echo Previous commit message: \"$LAST_COMMIT_MESSAGE\"; \
			else \
				git push $PUSH_ARGS;\
			fi; \
			unset -f f; \
		}; f"
		push-no-verify = push --no-verify
		push-reset='git push $CURRENT_REMOTE_NAME $CURRENT_BRANCH --force'
		push-and-delete-local-branch = push -d # git push --delete  ==> push local branch to remote and delete local branch
		push-and-delete-local-branch-COMMENT = !echo "git push --delete  ==> push local branch to remote and delete local branch"
		publish = !git push -u origin $(git branch-name) # Push the current branch to the remote "origin", and set it to track the upstream branch
		publish-COMMENT = !echo "Push the current branch to the remote 'origin', and set it to track the upstream branch"
		show-upstream = rev-parse --abbrev-ref --symbolic-full-name @{upstream}
		push-set-upstream = !git push -u origin $(git branch-name)
		pu-private = !git push private $(git branch-name) --no-verify

	##### PUSH TO GITLAB
		# options: https://docs.gitlab.com/ce/user/project/push_options.html
		# -o merge_request.create
		# -o merge_request.target=<branch_name>
		# -o merge_request.merge_when_pipeline_succeeds
		# -o merge_request.remove_source_branch
		# -o merge_request.title="<title>"
		# -o merge_request.description="<description>"
		# -o merge_request.label="<label>"
		# -o merge_request.unlabel="<label>"
		gitlab-pr = push -o merge_request.create -o merge_request.target=master -o merge_request.remove_source_branch
		gitlab-pr-bugfix = push -o merge_request.create -o merge_request.target=master -o merge_request.remove_source_branch -o merge_request.label="bugfix"
		gitlab-pr-feature = push -o merge_request.create -o merge_request.target=master -o merge_request.remove_source_branch -o merge_request.label="feature"

	##### MERGE
		m = "!f() { \
			local LAST_COMMIT_MESSAGE=$(git last-commit-message); \
			local MERGE_ARGS=\"$*\"; \
			if [[ $LAST_COMMIT_MESSAGE == *WIP* ]] && [[ $LAST_COMMIT_MESSAGE != *temp/WIP-improvements* ]]; then \
				echo Preventing merge due to the previous commit message includes WIP; \
				echo Previous commit message: \"$LAST_COMMIT_MESSAGE\"; \
			else \
				git merge $MERGE_ARGS;\
			fi; \
			unset -f f; \
		}; f"
		merge-no-commit = merge --no-commit --no-ff
		merge-with-commit = merge --no-ff # force a merge commit to be created
		merge-with-commit-COMMENT = !echo "force a merge commit to be created"

	##### ADD
		add-all = add -A
		aa = add-all

	##### REMOVE
		untrack-file-in-repo = rm --cache --
		untrack = untrack-file-in-repo

	##### DIFF
		sortdiff = !sh -c 'git diff "$@" | grep "^[+-]" | sort --key=1.2 | uniq -u -s1' # diff ignoring line number changes
		sortdiff-COMMENT = !echo "diff ignoring line number changes"
		commit-changes = "!f() { git diff \"$1^!\"; }; f"
		commit-compare = "!git diff $1 $2"
		commit-changes-print = diff-tree -p

	##### TAGS
		create-basic-tag = tag # git tag <tagname> or git tag <tagname> <commit ID>
		create-basic-tag-COMMENT = !echo "git tag <tagname> or git tag <tagname> <commit ID>"
		create-full-tag = tag -a # git tag -a <tagname> -m "<message associated with tag>" or git tag -a <tagname> <commmit ID> -m "<message associated with tag>"
		create-full-tag-COMMENT = !echo "git tag -a <tagname> -m '<message associated with tag>' or git tag -a <tagname> <commit ID> -m '<message associated with tag>'"
		t = create-full-tag
		list-all-tags = tag
		list-all-tags-with-details = g tag -l --format='%(color:yellow)%(tag):%(color:green) %(objectname:short):%(color:white) %(subject)%(color:normal)'
		list-remote-tags = ls-remote --tags origin
		filter-tags-list = tag -l # git tag -l <text>*
		filter-tags-list-COMMENT = !echo "git tag -l <text>*"
		ah-tags = tag -l AH-*
		wip-tags = tag -l *WIP*
		push-one-tag = push origin <tagname> # git push <remote> <tagname>
		push-one-tag-COMMENT = !echo "git push <remote> <tagname>"
		push-all-tags = push origin --tags
		delete-local-tag = tag -d # git tag -d <tagname>
		delete-local-tag-COMMENT = !echo "git tag -d <tagname>"
		delete-remote-tag = push origin --delete # git push origin --delete <tagname>
		delete-remote-tag-COMMENT = !echo "git push origin --delete <tagname>"
		override-local-tags-with-remote = fetch --tags --force


	##### LOG
		l = log --oneline --decorate --graph --all
		last = log -l HEAD # log last commit
		last-COMMENT = !echo "log last commit"
		last-commit-changes = log -p -1
		cwip = "!git log -g --grep=WIP --author=\"$(git config user.name)\" --no-merges"
		loga = log --graph --all --date=short --decorate=full --pretty=format:'%C(auto)%h %d %s %C(dim)[%an] %ar'
		log-branch = "!f() { \
			local THIS_BRANCH=$(git rev-parse --abbrev-ref HEAD); \
			local RECENT_BRANCH=\"${1:-$THIS_BRANCH}\"; \
			local OLD_BRANCH=\"${2:-master}\"; \
			echo \"Recent branch ${RECENT_BRANCH} compared with older branch: ${OLD_BRANCH}\"; \
			git log --no-merges --pretty='%C(auto)%h %d  %s %Cblue -- %ar, %an' --graph ${OLD_BRANCH}..${RECENT_BRANCH}; \
			unset -f f; \
		}; f"
		log-branch-COMMENT = !echo "This compares the commit difference from this branch (or 1st arg) with the master branch (or 2nd arg). Command: git log --no-merges --pretty='%Cred%h %C(yellow)%d %Creset %Cgreen %s %Cblue -- %ar, %an' --graph ${OLD_BRANCH}..${RECENT_BRANCH};"
		log-short = "!git log --graph --decorate --oneline --first-parent --pretty=format:'%C(auto)%h%d  %s  %Cblue-- %ar, %an'"
		log-all = log --date=short --all --since=2.months.ago --pretty=format:'%C(auto)%h %d %s %C(dim)[%an] %ar'
		log-all-me = "!git log --date=short --all --since=2.months.ago --author=\"$(git config user.name)\" --pretty=format:'%C(auto)%h %d %s %C(dim)[%an] %ar'"
		log-all-me-graph = "!git log --date=short --all --graph --decorate --since=2.months.ago --author=\"$(git config user.name)\" --pretty=format:'%C(yellow)%h %C(auto)%d %C(white)%s %C(dim)[%an] %ar'"
		log-all-me-4-days = "!git log --date=short --all --graph --decorate --since=4.days.ago --author=\"$(git config user.name)\" --pretty=format:'%C(auto)%h %d %s %C(dim)[%an] %ar'"
		last-commit-message = !sh -c 'git log --pretty="format:%Creset%s" -1 | cat'
		log-search = !git log --pretty --no-merges --grep
		log-search2 = log -S
		log-search-all = !git log -g --pretty --grep
		log-search-me = "!git log --author=\"$(git config user.name)\" --pretty --no-merges --grep"
		log-search-me-all = "!git log -g --author=\"$(git config user.name)\" --pretty --grep"
		log-search-file-for-all-changes = !git log --all --first-parent --no-merges --remotes --reflog --follow --patch --author-date-order -- 
		log-search-file-for-all-commits = !git log --all --first-parent --no-merges --remotes --reflog --follow --author-date-order -- 
		contributer-num-commits = shortlog -sn
		all-step-history = reflog
		orphan-commits = reflog --all
		search-orphan-commits = !git reflog --all | grep

	##### SHOW
		show-file-names = --pretty="" --name-only
		show-file-names2 = diff-tree --no-commit-id --name-only -r

	##### BRANCH
		branch-status = branch-status
		branch-name = !git rev-parse --abbrev-ref HEAD
		br = branch
		b = br
		branch-sort-by-date = branch --sort=committerdate
		bsort = branch --sort=-committerdate
		bs = bsort
		bsort-long = "!git for-each-ref --sort=-committerdate refs/heads/ --format='%(HEAD); %(objectname:short); %(refname:short); (%(committerdate:relative)); %(authorname);' | column -t -s ';'"
		bsl = bsort-long
		bclean = !sh -c 'git branch --merged ${1-master} | grep -v " ${1-master}$" | xargs -r git branch -d'
		b-search = !sh -c 'git branch -a | grep -i --color=auto $*' --
		bwip = branch --sort=committerdate --list *WIP* *wip*
		bw = "!git --no-pager branch --sort=committerdate --list *WIP* *wip*"
		bmerged = branch --merged
		not-merged = branch --no-merged
		rename-local-branch = branch -m
		rename-local-branch-COMMENT = !echo "Changing currently checked out branch: git branch –m <new-name> OR Changing other branch: git branch –m <old-name> <new-name>"
		rename-remote-branch = "!f(){ \
			git push origin :$1 $2 --no-verify;\
			git push origin -u $2 --no-verify;\
			};f"
		rename-remote-branch-COMMENT = !echo "Note: Deletes old branch before recreating with new branch name. Usage: g rename-remote-branch <old-name> <new-name>"
		rename-local-and-remote-branch = "!f(){ \
			git branch -m $1;\
			git push origin :$(git branch-name) $1 --no-verify;\
			git push origin -u $1 --no-verify;\
			};f"
		rename-remote-and-remote-branch-COMMENT = !echo "Note: Deletes old remote branch before recreating with new branch name. Usage: g rename-remote-branch <new-name>"
		delete-merged-local-branches = !sh -c 'git branch --merged ${1} | grep -v "\\* ${1}" | xargs -n 1 git branch -d'
		search-branch-names = !sh -c 'git branch -a | grep -i --color=auto $*' --
		delete-local-branch = branch -d  # git branch --delete <branch-name>
		delete-local-branch-COMMENT = !echo "git branch --delete <branch-name>"
		delete-remote-branch = push origin --delete # git push <remote-name> --delete <branch-name>  OR git push <remote-name> :<branch-name>
		delete-remote-branch-COMMENT = !echo "git push <remote-name> --delete <branch-name>  OR git push <remote-name> :<branch-name>"
		delete-remote-version-of-current-branch = !git push origin :$(git branch-name) # Delete the remote version of the current branch
		delete-remote-version-of-current-branch-COMMENT = !echo "Delete the remote version of the current branch"
		update-upstream = !git branch $(git branch-name) --set-upstream-to origin/$(git branch-name)
		set-upstream-on-push = !git push --set-upstream origin $(git branch-name)
		remove-upstream = branch --unset-upstream
		branches-with-commit = branch -a --contains 
		current-branch-contains-commit = "!f(){ \
			if git merge-base --is-ancestor $1 HEAD; then\
				echo I contain commit $1;\
			else\
				echo I do not contain commit $1;\
			fi;\
			};f"
		current-branch-contains-commit-COMMENT = !echo "Prints statement for whether the current branch contains a commit or not. git merge-base --is-ancestor $1 HEAD;"
		# branch-contains-commit = !git branch --contains $* | grep master
		# branch-contains-commit-COMMENT = !echo "Output the branch-name if the commit exists in that branch: git branch --contains <commit-id> | grep <branch-name>"
		# branch-contains-commit-ver2 = !git log master | grep $*
		# branch-contains-commit-COMMENT = !echo "Output the commit ID if the commit is within the master branch: git log <branch-name> | grep <commit-id>"
		# branch-contains-commit-ver3 = !git rev-list master | grep `git rev-parse $*`
		# branch-contains-commit-COMMENT = !echo "Output the commit ID if the commit is within the master branch: git rev-list <branch-name | grep `git rev-parse <commit-id>`"
		branch-status-graph = log --all --graph --decorate --oneline --simplify-by-decoration
		local-no-remote-branch = !git branch -vv | cut -c 3- | awk '$3 !~/\\[/ { print $1 }'
		local-no-remote-origin-branch = !git branch -vv | cut -c 3- | awk '$3 !~/\\[origin/ { print $1 }'
		local-branch-with-deleted-remote-branch = !git branch -vv | cut -c 3- | grep ': gone]'
		unpushed-branches = log --branches --not --remotes --no-walk --decorate --oneline
		differences-in-commits-between-branches = !git cherry -v $*
		differences-in-commits-between-branches2 = !git log --graph $(git branch-name)
		differences-in-commits-between-branches3 = !git log $* --not $(git for-each-ref --format='%(refname)' refs/heads/ | grep -v "$*")
		zz = !git log -p | git patch-id | grep $*
		zzz = !git show $* | git patch-id

	##### REMOTE
		list-remotes = remote -v
		list-remotes-with-details = remote -vv
		show-remote-details = remote show # ex. git remote show origin
		show-remote-details-COMMENT = !echo "ex. git remote show origin"
		change-remote = !git remote set-url $CURRENT_REMOTE_NAME  #ex. git remote set-url origin git@github.com:user/repo.git
		change-remote-COMMENT = !echo "ex. git remote set-url origin git@github.com:user/repo.git"

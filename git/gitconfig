		reset = reset HEAD~ # remove local commit, keep files
		reset-COMMENT = !echo "remove local commit, keep files"
		reset-undo = reset HEAD@{1}
		clear = reset --hard HEAD # remove local commit, delete file changes within commit
		clear-COMMENT = !echo "remove local commit, delete file changes within commit"
		cancel-merge = reset --merge
		undo-commit = reset --soft HEAD^
		undo-2-commits = reset --soft HEAD~2
		undo-3-commits = reset --soft HEAD~3
		undo-4-commits = reset --soft HEAD~4
		undo-stash-apply = !sh -c 'git stash show -p | git apply -R'
		undo-pushed-merge = !sh -c 'git revert -m 1 $1'
		reset-branch = !git reset origin/$(git branch-name) # Setting the local branch to exactly match the remote branch, keep files
		reset-branch-COMMENT = !echo "Setting the local branch to exactly match the remote branch, keep files"
		reset-branch-hard = !git reset --hard origin/$(git branch-name) # Setting the local branch to exactly match the remote branch and forcibly remove all local file changes
		reset-branch-hard-COMMENT = !echo "Setting the local branch to exactly match the remote branch and forcibly remove all local file changes"
		undo-merge = revert -m 1
		undo-merge-COMMENT = !echo "Undo a specific merge commit by using 'git revert -m 1 <COMMIT_ID>'"


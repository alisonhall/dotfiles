# **** Colourize the git output ****
# The accepted values are one or two of:
	# normal,
	# black,
	# red,
	# green,
	# yellow,
	# blue,
	# magenta,
	# cyan
	# white
# and optionally one of:
	# bold,
	# dim,
	# ul,
	# blink
	# reverse 
	# strike
	# bright
# If two colours are given the first is the foreground and the second is the background.
[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[pull] # How to reconcile divergent branches when pulling:
  rebase = false # merge (the default strategy)
  # rebase = true # rebase
  # ff = only # fast-forward only
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

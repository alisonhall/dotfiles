	##### COMMIT
		co = commit
		co-wip = "!f() { \
			local LAST_COMMIT_MESSAGE=$(git last-commit-message); \
			if [[ $LAST_COMMIT_MESSAGE == *WIP* ]] && [[ $LAST_COMMIT_MESSAGE != *temp/WIP-improvements* ]]; then \
				echo Preventing commit due to the previous commit message includes WIP; \
				echo Previous commit message: \"$LAST_COMMIT_MESSAGE\"; \
			else \
				git add -A; \
				git commit -m \"WIP\" --no-verify;\
			fi; \
			unset -f f; \
		}; f"
		com = "!f() { \
			local LAST_COMMIT_MESSAGE=$(git last-commit-message); \
			local COMMIT_MESSAGE=\"$1\"; \
			local SECONDARY_MESSAGE; \
			shift; \
			if [ \"$1\" == \"-m\" ] && [ -n \"$2\" ]; then \
				local SECONDARY_MESSAGE=\"$2\"; \
				shift; \
				shift; \
			fi; \
			local COMMIT_ARGS=\"$*\"; \
			if [[ $LAST_COMMIT_MESSAGE == *WIP* ]] && [[ $LAST_COMMIT_MESSAGE != *temp/WIP-improvements* ]]; then \
				echo Preventing commit due to the previous commit message includes WIP; \
				echo Previous commit message: \"$LAST_COMMIT_MESSAGE\"; \
			else \
				git commit -m \"$COMMIT_MESSAGE\" -m \"$SECONDARY_MESSAGE\" $COMMIT_ARGS; \
			fi; \
